    "services": {
      "ultras": {
        "kind": "count",
        "aircraft": true,
        "specs": [
          {
            "fn": "COUNTIFS",
            "table": "Ultra_Debriefs",
            "sum_col": null,
            "criteria": [
              [
                "Location",
                "CMH"
              ],
              [
                "Service",
                "Ultra Cleaning"
              ]
            ]
          }
        ]
      },
      "shroudcleaning": {
        "kind": "count",
        "aircraft": false,
        "specs": [
          {
            "fn": "SUMIFS",
            "table": "Ultra_Debriefs",
            "sum_col": "Shroud Count",
