  "CLE DAY": {
    "labor_keys": [
      "CLE AA"
    ],
    "salary_keys": [],
    "shift_window": {
      "from": 7,
      "to": 19
    },
    "_comment": "CLE's one labor dist (CLE AA) is split into two crews by punch-in clock hour. DAY takes punches starting 07:00-18:59 local and carries no salaried imputation - the single CLE AA salaried head is assigned to NIGHT. Day shifts get plain calendar-day attribution (a 7 AM start belongs to that day, not the previous one). Budget is the facility share on the CLE DAY sheet; all Ultra and Frontier work belongs to NIGHT."
  },
