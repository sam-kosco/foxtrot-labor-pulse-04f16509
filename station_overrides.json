    "labor_keys": [
      "CLE AA"
    ],
    "salary_keys": [
      "CLE AA"
    ],
    "shift_window": {
      "from": 19,
      "to": 7
    },
    "_comment": "NIGHT takes CLE AA punches starting 19:00-06:59 local plus ALL CLE AA salaried time. The window wraps midnight, so it keeps the punch-in-minus-12h attribution that groups an overnight shift onto the day it started. Carries the Ultra, Shroud and Frontier work plus its share of the facility budget.",
